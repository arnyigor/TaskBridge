{
  "server": {
    "host": "0.0.0.0",
    "port": 8787,
    "maxBodyMb": 25,
    "maxUploadMb": 64,
    "maxEventsPerRequest": 20000,
    "sqlite": {
      "synchronous": "NORMAL",
      "busyTimeoutMs": 5000
    },
    "auth": {
      "enabled": false
    },
    "https": {
      "enabled": false,
      "port": 8443
    }
  },
  "pi": {
    "command": "pi",
    "args": [],
    "persistSessions": true,
    "projectTrust": "approve",
    "abortTimeoutMs": 10000,
    "mcp": {
      "mode": "inherit"
    }
  },
  "localRuntime": {
    "healthUrl": "http://127.0.0.1:8080/health",
    "provider": "llama.cpp",
    "router": {
      "enabled": false,
      "command": "C:\\path\\to\\llama-server.exe",
      "args": ["--host", "127.0.0.1", "--port", "8080", "--models-preset", "C:\\path\\to\\models.ini", "--models-max", "1"],
      "cwd": "C:\\path\\to\\llamacpp",
      "startTimeoutMs": 120000,
      "loadTimeoutMs": 900000
    },
    "defaultProfile": "text",
    "auto": {
      "enabled": false,
      "visionProfile": "vision",
      "textProfile": "text"
    },
    "profiles": [
      {
        "id": "text",
        "name": "Текст",
        "enabled": false,
        "command": "C:\\path\\to\\llama-server.exe",
        "args": ["-m", "C:\\path\\to\\model.gguf", "--host", "127.0.0.1", "--port", "8080"],
        "cwd": ""
      },
      {
        "id": "vision",
        "name": "Vision",
        "enabled": false,
        "command": "C:\\path\\to\\llama-server.exe",
        "args": ["-m", "C:\\path\\to\\model.gguf", "-mm", "C:\\path\\to\\mmproj.gguf", "--host", "127.0.0.1", "--port", "8080"],
        "cwd": ""
      }
    ],
    "managed": {
      "enabled": false,
      "command": "",
      "args": [],
      "cwd": ""
    }
  },
  "cloud": {
    "enabled": false,
    "url": "https://your-taskbridge.vercel.app",
    "machineId": "home-pc",
    "machineSecretEnv": "TASKBRIDGE_MACHINE_SECRET",
    "eventFlushMs": 100,
    "pollIntervalMs": 1500,
    "maxBatchEvents": 100,
    "maxPayloadKb": 256,
    "maxOutboxMb": 100,
    "processedCommandLimit": 2000
  },
  "workspace": {
    "requireCleanSource": true,
    "useGitWorktreeByDefault": true
  },
  "projectBrowser": {
    "roots": []
  },
  "projects": [
    {
      "id": "example-project",
      "name": "Example project (edit config.json)",
      "path": "C:\\path\\to\\your\\git-project",
      "useWorktree": true,
      "verification": []
    }
  ]
}
