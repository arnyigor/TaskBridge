{
  "server": {
    "host": "0.0.0.0",
    "port": 8787,
    "maxBodyMb": 25,
    "maxUploadMb": 64,
    "maxEventsPerRequest": 20000,
    "sqlite": {
      "synchronous": "NORMAL",
      "busyTimeoutMs": 5000
    },
    "auth": {
      "enabled": false
    },
    "https": {
      "enabled": false,
      "port": 8443
    }
  },
  "pi": {
    "command": "pi",
    "args": [],
    "persistSessions": true,
    "projectTrust": "approve",
    "abortTimeoutMs": 10000
  },
  "localRuntime": {
    "healthUrl": "http://127.0.0.1:8080/health",
    "defaultProfile": "text",
    "auto": {
      "enabled": false,
      "visionProfile": "vision",
      "textProfile": "text"
    },
    "profiles": [
      {
        "id": "text",
        "name": "Текст",
        "enabled": false,
        "command": "C:\\path\\to\\llama-server.exe",
        "args": ["-m", "C:\\path\\to\\model.gguf", "--host", "127.0.0.1", "--port", "8080"],
        "cwd": ""
      },
      {
        "id": "vision",
        "name": "Vision",
        "enabled": false,
        "command": "C:\\path\\to\\llama-server.exe",
        "args": ["-m", "C:\\path\\to\\model.gguf", "-mm", "C:\\path\\to\\mmproj.gguf", "--host", "127.0.0.1", "--port", "8080"],
        "cwd": ""
      }
    ],
    "managed": {
      "enabled": false,
      "command": "",
      "args": [],
      "cwd": ""
    }
  },
  "approvals": {
    "enabled": false,
    "timeoutMinutes": 1440,
    "timeoutPolicy": "KEEP_WAITING",
    "failsafe": "block",
    "approveShell": true,
    "approveOutsideWorkspace": true,
    "approveRead": false,
    "extraPatterns": []
  },
  "workspace": {
    "requireCleanSource": true,
    "useGitWorktreeByDefault": true
  },
  "cloud": {
    "enabled": false,
    "url": "",
    "machineId": "",
    "machineSecret": "",
    "machineDisplayName": "",
    "authMode": "bearer",
    "realtime": false,
    "eventFlushMs": 75,
    "eventBatchMax": 100,
    "eventBatchMaxKb": 256,
    "heartbeatSeconds": 20,
    "idlePollSeconds": 5,
    "activePollSeconds": 1,
    "maxOutboxMb": 100,
    "redactPaths": true,
    "coalesceDeltas": true,
    "toolOutput": {
      "rollingKb": 64,
      "tailKb": 64,
      "snapshotMs": 500,
      "maxFullMb": 4
    }
  },
  "projectBrowser": {
    "roots": []
  },
  "projects": [
    {
      "id": "example-project",
      "name": "Example project (edit config.json)",
      "path": "C:\\path\\to\\your\\git-project",
      "useWorktree": true,
      "verification": []
    }
  ]
}
