{
  "server": {
    "host": "0.0.0.0",
    "port": 8787,
    "maxBodyMb": 25,
    "maxUploadMb": 64,
    "maxEventsPerRequest": 20000,
    "maxHistoryMb": 6,
    "sqlite": {
      "synchronous": "NORMAL",
      "busyTimeoutMs": 5000
    },
    "auth": {
      "enabled": false,
      "allowedOrigins": []
    },
    "tailscale": {
      "ip": null,
      "httpsUrl": null
    },
    "https": {
      "enabled": false,
      "port": 8443
    }
  },
  "pi": {
    "command": "pi",
    "args": [],
    "persistSessions": true,
    "projectTrust": "approve",
    "abortTimeoutMs": 10000,
    "mcp": {
      "mode": "inherit"
    }
  },
  "queue": {
    "maxConcurrentSessions": 4,
    "maxSessionsPerDirectory": 0,
    "providerConcurrency": {
      "deepseek": 2,
      "openai": 4
    },
    "rateLimitBackoffMs": 30000,
    "pollMs": 1000
  },
  "localRuntime": {
    "healthUrl": "http://127.0.0.1:8080/health",
    "provider": "llama.cpp",
    "router": {
      "enabled": false,
      "command": "C:\\path\\to\\llama-server.exe",
      "args": [
        "--host",
        "127.0.0.1",
        "--port",
        "8080",
        "--models-preset",
        "C:\\path\\to\\models.ini",
        "--models-max",
        "1"
      ],
      "cwd": "C:\\path\\to\\llamacpp",
      "startTimeoutMs": 120000,
      "loadTimeoutMs": 900000
    },
    "defaultProfile": "text",
    "auto": {
      "enabled": false,
      "visionProfile": "vision",
      "textProfile": "text"
    },
    "profiles": [
      {
        "id": "text",
        "name": "Текст",
        "enabled": false,
        "command": "C:\\path\\to\\llama-server.exe",
        "args": [
          "-m",
          "C:\\path\\to\\model.gguf",
          "--host",
          "127.0.0.1",
          "--port",
          "8080"
        ],
        "cwd": ""
      },
      {
        "id": "vision",
        "name": "Vision",
        "enabled": false,
        "command": "C:\\path\\to\\llama-server.exe",
        "args": [
          "-m",
          "C:\\path\\to\\model.gguf",
          "-mm",
          "C:\\path\\to\\mmproj.gguf",
          "--host",
          "127.0.0.1",
          "--port",
          "8080"
        ],
        "cwd": ""
      }
    ],
    "managed": {
      "enabled": false,
      "command": "",
      "args": [],
      "cwd": ""
    },
    "externalServers": [
      {
        "provider": "strata-iq3",
        "name": "Strata IQ3_XXS (8082)",
        "model": "qwen3.8-flash-next-iq3-xxs",
        "baseUrl": "http://127.0.0.1:8082",
        "start": [
          "C:\\path\\to\\venv\\Scripts\\python.exe",
          "C:\\path\\to\\Strata\\serve\\server.py",
          "--engine",
          "strata",
          "--config",
          "C:\\path\\to\\Strata\\strata-iq3_xxs.json",
          "--port",
          "8082"
        ],
        "cwd": "C:\\path\\to\\Strata",
        "loadTimeoutMs": 600000
      }
    ]
  },
  "approvals": {
    "enabled": false,
    "timeoutMinutes": 1440,
    "timeoutPolicy": "KEEP_WAITING",
    "failsafe": "block",
    "approveShell": true,
    "approveOutsideWorkspace": true,
    "approveRead": false,
    "extraPatterns": []
  },
  "workspace": {
    "requireCleanSource": true,
    "useGitWorktreeByDefault": true
  },
  "cloud": {
    "enabled": false,
    "url": "",
    "machineId": "",
    "machineSecret": "",
    "machineDisplayName": "",
    "authMode": "bearer",
    "realtime": false,
    "eventFlushMs": 75,
    "eventBatchMax": 100,
    "eventBatchMaxKb": 256,
    "heartbeatSeconds": 20,
    "idlePollSeconds": 5,
    "activePollSeconds": 1,
    "maxOutboxMb": 100,
    "redactPaths": true,
    "coalesceDeltas": true,
    "toolOutput": {
      "rollingKb": 64,
      "tailKb": 64,
      "snapshotMs": 500,
      "maxFullMb": 4
    }
  },
  "projectBrowser": {
    "roots": []
  },
  "deepseek": {
    "costHistoryPath": "",
    "cacheMs": 600000
  },
  "providerStatus": {
    "wormsoft": {
      "cacheMs": 60000,
      "endsAt": "2026-09-29"
    },
    "routerai": {
      "cacheMs": 600000
    }
  },
  "projects": [
    {
      "id": "example-project",
      "name": "Example project (edit config.json)",
      "path": "C:\\path\\to\\your\\git-project",
      "useWorktree": true,
      "verification": []
    }
  ]
}
