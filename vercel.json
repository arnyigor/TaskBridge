{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "web",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/session/:id", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.mjs": { "memory": 256, "maxDuration": 30 }
  }
}
