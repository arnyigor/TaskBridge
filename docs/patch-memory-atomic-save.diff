+def _file_sha(path: Path) -> Optional[str]:
+    try:
+        return hashlib.sha256(path.read_bytes()).hexdigest()
+    except FileNotFoundError:
+        return None
+
+
+@contextlib.contextmanager
+def _topic_lock(topic: str):
+    # Stable lock inode/file, never unlink it: the OS releases the byte lock on crash.
+    directory = MEMORY_DIR / '.locks'
+    directory.mkdir(parents=True, exist_ok=True)
+    with (directory / f'{topic}.lock').open('a+b') as handle:
+        if handle.seek(0, 2) == 0:
+            handle.write(b'0')
+            handle.flush()
+        handle.seek(0)
+        try:
+            if os.name == 'nt':
+                import msvcrt
+                msvcrt.locking(handle.fileno(), msvcrt.LK_NBLCK, 1)
+            else:
+                import fcntl
+                fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except OSError as exc:
+            raise MemoryConflict('topic is locked by another save') from exc
+        try:
+            yield
+        finally:
+            handle.seek(0)
+            if os.name == 'nt':
+                msvcrt.locking(handle.fileno(), msvcrt.LK_UNLCK, 1)
+            else:
+                fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
+
+
+def _write_durable(path: Path, data: bytes, security_source: Optional[Path] = None) -> None:
+    # Exclusive creation: never overwrite an existing backup or temporary file.
+    with path.open('xb') as handle:
+        if security_source is not None:
+            _copy_file_security(security_source, path)
+        handle.write(data)
+        handle.flush()
+        os.fsync(handle.fileno())
+    if path.read_bytes() != data:
+        raise OSError('written file failed verification')
+
+
+def _copy_file_security(source: Path, target: Path) -> None:
+    if os.name != 'nt':
+        import stat
+        os.chmod(target, stat.S_IMODE(source.stat().st_mode))
+        return
+    import ctypes
+    from ctypes import wintypes
+    kernel = ctypes.WinDLL('kernel32', use_last_error=True)
+    attributes = kernel.GetFileAttributesW
+    attributes.argtypes = [wintypes.LPCWSTR]
+    attributes.restype = wintypes.DWORD
+    value = attributes(str(source))
+    if value == 0xFFFFFFFF:
+        raise ctypes.WinError(ctypes.get_last_error())
+    # Only ordinary/archive files are supported. Do not silently discard read-only,
+    # hidden/system, encrypted/compressed, sparse or reparse-point attributes.
+    if value & ~(0x80 | 0x20):
+        raise PermissionError('special file attributes require separate preservation support')
+    advapi = ctypes.WinDLL('advapi32', use_last_error=True)
+    get_security = advapi.GetFileSecurityW
+    get_security.argtypes = [wintypes.LPCWSTR, wintypes.DWORD, wintypes.LPVOID,
+                             wintypes.DWORD, ctypes.POINTER(wintypes.DWORD)]
+    get_security.restype = wintypes.BOOL
+    set_security = advapi.SetFileSecurityW
+    set_security.argtypes = [wintypes.LPCWSTR, wintypes.DWORD, wintypes.LPVOID]
+    set_security.restype = wintypes.BOOL
+    control = advapi.GetSecurityDescriptorControl
+    control.argtypes = [wintypes.LPVOID, ctypes.POINTER(wintypes.WORD), ctypes.POINTER(wintypes.DWORD)]
+    control.restype = wintypes.BOOL
+    # Owner, primary group and DACL. SACL requires separate audit privileges;
+    # this helper does not claim to preserve audit/integrity metadata.
+    information = 0x1 | 0x2 | 0x4
+    def read(path):
+        needed = wintypes.DWORD()
+        get_security(str(path), information, None, 0, ctypes.byref(needed))
+        if not needed.value:
+            raise ctypes.WinError(ctypes.get_last_error())
+        buffer = ctypes.create_string_buffer(needed.value)
+        if not get_security(str(path), information, buffer, len(buffer), ctypes.byref(needed)):
+            raise ctypes.WinError(ctypes.get_last_error())
+        return buffer
+    descriptor = read(source)
+    flags, revision = wintypes.WORD(), wintypes.DWORD()
+    if not control(descriptor, ctypes.byref(flags), ctypes.byref(revision)):
+        raise ctypes.WinError(ctypes.get_last_error())
+    # Preserve DACL inheritance protection, not just the ACEs.
+    protected = 0x80000000 if flags.value & 0x1000 else 0x20000000
+    # Setting owner/group requires WRITE_OWNER even if unchanged. Require the
+    # inherited temp owner/group to match, then set only DACL (WRITE_DAC).
+    existing = read(target)
+    equal_sid = advapi.EqualSid
+    equal_sid.argtypes = [wintypes.LPVOID, wintypes.LPVOID]
+    equal_sid.restype = wintypes.BOOL
+    for name in ('GetSecurityDescriptorOwner', 'GetSecurityDescriptorGroup'):
+        get_sid = getattr(advapi, name)
+        get_sid.argtypes = [wintypes.LPVOID, ctypes.POINTER(wintypes.LPVOID), ctypes.POINTER(wintypes.BOOL)]
+        get_sid.restype = wintypes.BOOL
+        old_sid, new_sid = wintypes.LPVOID(), wintypes.LPVOID()
+        defaulted = wintypes.BOOL()
+        if not get_sid(descriptor, ctypes.byref(old_sid), ctypes.byref(defaulted)):
+            raise ctypes.WinError(ctypes.get_last_error())
+        if not get_sid(existing, ctypes.byref(new_sid), ctypes.byref(defaulted)):
+            raise ctypes.WinError(ctypes.get_last_error())
+        if not equal_sid(old_sid, new_sid):
+            raise PermissionError('cannot preserve original owner/group on replacement')
+    if not set_security(str(target), 0x4 | protected, descriptor):
+        raise ctypes.WinError(ctypes.get_last_error())
+    copied = read(target)
+    copied_flags = wintypes.WORD()
+    if not control(copied, ctypes.byref(copied_flags), ctypes.byref(revision)):
+        raise ctypes.WinError(ctypes.get_last_error())
+    if (flags.value & 0x1000) != (copied_flags.value & 0x1000):
+        raise OSError('DACL inheritance protection changed')
+    get_dacl = advapi.GetSecurityDescriptorDacl
+    get_dacl.argtypes = [wintypes.LPVOID, ctypes.POINTER(wintypes.BOOL),
+                        ctypes.POINTER(wintypes.LPVOID), ctypes.POINTER(wintypes.BOOL)]
+    get_dacl.restype = wintypes.BOOL
+    def acl_bytes(sd):
+        present, defaulted, pointer = wintypes.BOOL(), wintypes.BOOL(), wintypes.LPVOID()
+        if not get_dacl(sd, ctypes.byref(present), ctypes.byref(pointer), ctypes.byref(defaulted)):
+            raise ctypes.WinError(ctypes.get_last_error())
+        if not present.value or not pointer.value:
+            return (bool(present.value), None)
+        # ACL header stores its byte length at offset 2 (USHORT AclSize).
+        length = ctypes.c_ushort.from_address(pointer.value + 2).value
+        return (True, ctypes.string_at(pointer, length))
+    if acl_bytes(copied) != acl_bytes(descriptor):
+        raise OSError('DACL copy failed verification')
+
