+def _journal_path(topic: str) -> Path:
+    return MEMORY_DIR / '.operations' / f'{topic}.json'
+
+
+def _write_journal(topic: str, record: Dict[str, Any]) -> None:
+    target = _journal_path(topic)
+    target.parent.mkdir(parents=True, exist_ok=True)
+    temp = target.with_name(f'{target.name}.{uuid.uuid4().hex}.tmp')
+    try:
+        _write_durable(temp, json.dumps(record, ensure_ascii=False).encode('utf-8'))
+        os.replace(temp, target)
+    finally:
+        temp.unlink(missing_ok=True)
+
+
+def _recover_topic(topic: str, path: Path) -> Optional[Dict[str, Any]]:
+    journal = _journal_path(topic)
+    if not journal.exists():
+        return None
+    record = json.loads(journal.read_text(encoding='utf-8'))
+    if record.get('state') in ('committed', 'aborted'):
+        return record
+    current = _file_sha(path)
+    if current == record['new_sha256']:
+        record['state'] = 'committed'
+    elif current == record['old_sha256']:
+        record['state'] = 'aborted'
+    else:
+        # Never overwrite an unknown version, nor replay a temp over user data.
+        raise MemoryConflict('recovery found an unknown topic version')
+    _write_journal(topic, record)
+    return record
+
