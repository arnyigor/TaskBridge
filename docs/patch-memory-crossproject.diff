+# --- pi-memory-md: единственный ИСТОЧНИК ПРАВДЫ для новой памяти ---
+# Писатель там же (skills memory-write/import). Здесь только чтение:
+# два писателя дали бы split-brain.
+#
+# Зачем этот слой нужен: расширение инжектит индекс ТОЛЬКО текущего проекта и
+# НЕ умеет искать по другим (memory_search: scope=project|global|all — это
+# текущий проект + общий каталог, не другие проекты). Кросс-проектный
+# обзор и поиск закрывает только этот инструмент.
+MEMORY_MD_DIR = Path.home() / ".pi" / "memory-md"
+
+# Бюджет индекса на проект. Расширение инжектит path+description+tags КАЖДОЙ
+# заметки в КАЖДУЮ сессию проекта, без потолка (~216 символов на заметку).
+# Это прямой наследник прежнего MAX_MEMORY_TOKENS_LIMIT, но приложенный к
+# правильной оси: лимитируется не размер заметки (контент не инжектится),
+# а суммарный размер индекса и число заметок.
+MEMORY_MD_INDEX_BUDGET_CHARS = 8000
+
+
+def _parse_md_frontmatter(text: str) -> Dict[str, str]:
+    """Разбор frontmatter pi-memory-md: description / tags / created / updated."""
+    if not text.startswith("---"):
+        return {}
+    end = text.find("\n---", 3)
+    if end == -1:
+        return {}
+    found: Dict[str, str] = {}
+    for line in text[4:end].splitlines():
+        m = re.match(r"^(\w+):\s*(.*)$", line.strip())
+        if m:
+            found[m.group(1)] = m.group(2).strip().strip('"')
+    return found
+
+
+def _render_tags(raw: str) -> str:
+    """tags -> строка как в индексе: массив через ', ' (memoryContextItemTpl)."""
+    raw = (raw or "").strip()
+    if raw.startswith("[") and raw.endswith("]"):
+        items = [x.strip().strip('"').strip("'") for x in raw[1:-1].split(",")]
+        return ", ".join(x for x in items if x)
+    return raw
+
+
+def _memory_md_wrapper_chars(project_dir: Path) -> int:
+    """Размер общей обёртки индекса. Точная копия memoryContextHeaderTpl()
+    и закрывающих тегов (memory-core.ts:494-524) — чтобы сумма по проекту была
+    сравнима с реально инжектируемым размером."""
+    lines = (
+        '<memory_context mode="normal">',
+        "<instructions>",
+        "These memory files can help you better understand the project and the user.",
+        "</instructions>",
+        f'<memory_files source="project" directory="{project_dir}">',
+        "</memory_files>",
+        "</memory_context>",
+    )
+    return sum(len(s) + 1 for s in lines)
+
+
+def _iter_memory_md_notes():
+    """Обход заметок pi-memory-md: (project, relpath, Path, delivered).
+
+    delivered=False — заметка лежит ВНЕ <Project>/core. Она есть на диске, но
+    расширение её НЕ инжектит: гейт index.ts:209-218 требует существования
+    core/, а scanDir (memory-core.ts:584) сканирует только его. Такие заметки
+    надо показывать явно, иначе получается «тихий ноль доставки».
+    """
+    if not MEMORY_MD_DIR.is_dir():
+        return
+    for proj in sorted(MEMORY_MD_DIR.iterdir()):
+        if not proj.is_dir() or proj.name.startswith("."):
+            continue
+        core = proj / "core"
+        for f in sorted(proj.rglob("*.md")):
+            if ".git" in f.parts:
+                continue
+            rel = f.relative_to(proj).as_posix()
+            delivered = str(f).startswith(str(core))
+            yield proj.name, rel, f, delivered
+
+
+def _memory_md_projects() -> Dict[str, Any]:
+    """Размер индекса, который расширение инжектит для каждого проекта."""
+    projects: Dict[str, Any] = {}
+    for project, rel, path, delivered in _iter_memory_md_notes():
+        st = projects.setdefault(
+            project,
+            {"notes": 0, "chars": 0, "undelivered": 0, "detail": []},
+        )
+        if not delivered:
+            st["undelivered"] += 1
+            continue
+        try:
+            fm = _parse_md_frontmatter(path.read_text(encoding="utf-8", errors="replace"))
+        except OSError:
+            continue
+        desc = fm.get("description") or "No description"
+        tags = _render_tags(fm.get("tags") or "none")
+        # Копия шаблона memoryContextItemTpl() (memory-core.ts:479-492).
+        # Путь в индексе абсолютный — это ~65 символов на заметку.
+        st["notes"] += 1
+        st["chars"] += (
+            len(f"- path: {path}\n")
+            + len("  priority: normal\n")
+            + len(f"  description: {desc}\n")
+            + len(f"  tags: {tags}\n")
+        )
+        st["detail"].append({"path": rel, "description": desc[:110]})
+    for name, st in projects.items():
+        # + общая обёртка, иначе цифра не сравнима с реально инжектируемой
+        st["chars"] += _memory_md_wrapper_chars(MEMORY_MD_DIR / name)
+        st["tokens_approx"] = st["chars"] // 4
+        st["over_budget"] = st["chars"] > MEMORY_MD_INDEX_BUDGET_CHARS
+    return projects
+
