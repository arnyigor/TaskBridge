<?xml version="1.0" encoding="utf-8"?>
<!--
  The client keeps the pairing token, the selected machine and the chat cache on
  the device; none of it belongs in a cloud backup or in a device-to-device
  transfer. android:allowBackup="false" is deprecated from Android 12 and only
  covers cloud backups there, so the explicit rules are what the platform reads.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
